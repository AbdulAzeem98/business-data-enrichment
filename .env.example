# Copy to .env and fill in only the keys you use.
API_TOKEN=change-this-to-a-long-random-secret

# Optional: preferred scraper for JavaScript-heavy sites. Without this,
# the app uses Requests/BeautifulSoup for public static pages.
FIRECRAWL_API_KEY=

# Optional: OpenAI-compatible structured extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Network timeout for public website requests
REQUEST_TIMEOUT_SECONDS=20
MAX_CONTENT_CHARS=24000
